# Cloudflare Pages 標頭設定(部署時自動套用)。
# 安全標頭全站套用;快取依資源型別分級。

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# HTML 不快取:改版即時生效,使用者不會卡在舊版引擎
/index.html
  Cache-Control: no-cache
/web/index.html
  Cache-Control: no-cache

# Service Worker 不快取:瀏覽器每次導覽都重新比對 sw.js,改版(CACHE_VERSION)才能即時生效,
# 不會被 HTTP 快取卡住舊 SW。sw.js 在站根 → scope=/,涵蓋 /web/(app)+/data/(題庫)+根 landing。
/sw.js
  Cache-Control: no-cache

# 引擎程式碼:更新頻率低,快取一天(改版可用檔名加版本破快取)
/web/*.js
  Cache-Control: public, max-age=86400
/web/*.css
  Cache-Control: public, max-age=86400

# 題庫資料:改 no-cache＝每次都發條件式請求驗證(未變回 304、近零流量),不是不快取。
# 原本的 max-age=3600 讓改完資料最長 1 小時仍吃舊版;配合 sw.js 的 SWR 一起根治。
#
# X-Robots-Tag: noindex —— 題庫 JSON「可以抓、不要收錄」。
# 這一行取代了 robots.txt 舊有的 `Disallow: /data/`：那條禁止的是「抓」，
# 但 llms.txt 與 datapackage.json 正是叫 agent 來抓這裡，兩者直接打架。
# 想避免的其實只是「幾 MB 的 JSON 佔掉檢索預算又被當成網頁收錄」，那是 noindex 的職權。
/data/*
  Cache-Control: no-cache
  X-Robots-Tag: noindex
